{
  "name": "work-life-balance-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47832 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.js *.json index.html",
    "format:check": "prettier --check src tests *.ts *.js *.json index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-is": "19.1.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.11.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3"
  }
}
