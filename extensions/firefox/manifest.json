{
  "manifest_version": 2,
  "name": "Work Life Balance",
  "version": "0.2.0",
  "description": "Локальный учёт времени активной вкладки Firefox в Work Life Balance.",
  "browser_specific_settings": {
    "gecko": { "id": "work-life-balance@local.invalid", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"] } }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "incognito": "not_allowed",
  "background": { "scripts": ["collector.js", "background.js"], "persistent": true },
  "browser_action": { "default_title": "Work Life Balance", "default_popup": "popup.html" },
  "content_security_policy": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'none'; object-src 'none'"
}
